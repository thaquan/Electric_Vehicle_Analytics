// Execute each EVALUATE on deployed SM_EV_Analytics after binding to a verified v2 run.
// Expected totals: 668665 / 116779 / 551886 / 0.17464500160768098.
EVALUATE ROW("respondent_count", [Respondents], "yes_count", [Intending to Buy EV], "no_count", [Not Intending to Buy EV], "purchase_intent_rate", [Purchase Intent Rate])

// Compare these 35 groups with the endpoint SQL and metadata/star_expected_metrics.json.
EVALUATE UNION(
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Demographics'[age_band], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "age_band", "segment_value", 'Demographics'[age_band], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Income'[income_band], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "income_band", "segment_value", 'Income'[income_band], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Mobility'[commute_band], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "commute_band", "segment_value", 'Mobility'[commute_band], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Demographics'[Gender], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "Gender", "segment_value", 'Demographics'[Gender], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Demographics'[City_Type], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "City_Type", "segment_value", 'Demographics'[City_Type], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Mobility'[Current_Car_Type], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "Current_Car_Type", "segment_value", 'Mobility'[Current_Car_Type], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Charging'[Home_Charging_Possible], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "Home_Charging_Possible", "segment_value", 'Charging'[Home_Charging_Possible], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Attitude and Incentive'[Subsidy_Available], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "Subsidy_Available", "segment_value", 'Attitude and Incentive'[Subsidy_Available], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Attitude and Incentive'[Range_Anxiety_Level], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "Range_Anxiety_Level", "segment_value", 'Attitude and Incentive'[Range_Anxiety_Level], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r]),
    SELECTCOLUMNS(SUMMARIZECOLUMNS('Attitude and Incentive'[Environmental_Concern_Level], "n", [Respondents], "y", [Intending to Buy EV], "no", [Not Intending to Buy EV], "r", [Purchase Intent Rate]), "segment_dimension", "Environmental_Concern_Level", "segment_value", 'Attitude and Incentive'[Environmental_Concern_Level], "respondent_count", [n], "yes_count", [y], "no_count", [no], "purchase_intent_rate", [r])
)

// Combined filters must preserve Yes + No = Respondents.
EVALUATE SUMMARIZECOLUMNS('Demographics'[Gender], 'Income'[income_band], 'Charging'[Home_Charging_Possible], "respondent_count", [Respondents], "yes_count", [Intending to Buy EV], "no_count", [Not Intending to Buy EV], "purchase_intent_rate", [Purchase Intent Rate], "difference", [Respondents] - [Intending to Buy EV] - [Not Intending to Buy EV])

// Empty selection: rate must be BLANK (no division by zero).
EVALUATE CALCULATETABLE(ROW("rate_is_blank", ISBLANK([Purchase Intent Rate])), FILTER(ALL('Income'[income_band]), FALSE()))
