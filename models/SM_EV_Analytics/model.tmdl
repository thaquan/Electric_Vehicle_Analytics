/// Gold v2 star: verified E2E 78f9cdfe-1e19-4624-bede-042310ec9bb9, Gold run 20260925T152721965637Z. Synthetic purchase intent, not actual sales.
model SM_EV_Analytics
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table 'EV Respondents'
ref table Demographics
ref table Income
ref table Mobility
ref table Charging
ref table 'Attitude and Incentive'

