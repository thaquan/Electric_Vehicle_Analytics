/// Fact: one labeled synthetic train respondent. Five dimension keys. Verified Gold v2 run 20260925T152721965637Z.
table 'EV Respondents'
	lineageTag: 19a80358-f432-4857-8e09-0e26efa49f05

	/// Number of labeled train respondents in the current filter context.
	measure Respondents = COUNTROWS('EV Respondents')
		formatString: #,0
		displayFolder: Purchase intent
		lineageTag: 4be63eb7-b5e1-444b-9681-932a53a52fd8

	/// Yes respondents in the current context; blank when no fact rows, zero for a populated group with no Yes responses.
	measure 'Intending to Buy EV' = SUM('EV Respondents'[will_buy_ev_flag])
		formatString: #,0
		displayFolder: Purchase intent
		lineageTag: f16c024e-e107-4232-a9fd-c7bfcf3d99b4

	/// Respondents whose Will_Buy_EV is No.
	measure 'Not Intending to Buy EV' = [Respondents] - [Intending to Buy EV]
		formatString: #,0
		displayFolder: Purchase intent
		lineageTag: acee68a7-d18b-41ec-bd65-1d4f01b8dd34

	/// Share of respondents with purchase intent; not sales conversion.
	measure 'Purchase Intent Rate' = DIVIDE([Intending to Buy EV], [Respondents])
		formatString: 0.00%
		displayFolder: Purchase intent
		lineageTag: 3d86ea81-5777-4aaf-a166-8f5f474ceec0

	/// Average respondent age.
	measure 'Average Age' = AVERAGE('EV Respondents'[Age])
		formatString: 0.0
		displayFolder: Respondent profile
		lineageTag: 86bb0fe5-d021-4c27-9335-9672c0648733

	/// Average annual income in USD.
	measure 'Average Annual Income USD' = AVERAGE('EV Respondents'[Annual_Income_USD])
		formatString: $#,0.00
		displayFolder: Respondent profile
		lineageTag: 6065ef99-94f8-4b4e-889a-e42a63f308f9

	/// Average daily commute in km.
	measure 'Average Daily Commute km' = AVERAGE('EV Respondents'[Daily_Commute_km])
		formatString: 0.0
		displayFolder: Respondent profile
		lineageTag: ef4e1fce-9c5a-4011-9ba4-761a916edd3a

	/// Average number of cars owned.
	measure 'Average Cars Owned' = AVERAGE('EV Respondents'[Number_of_Cars_Owned])
		formatString: 0.00
		displayFolder: Respondent profile
		lineageTag: 9a6c991f-77ec-45a3-a636-46424746b9dc

	/// Share with home charging access within current filters.
	measure 'Home Charging Access Rate' = DIVIDE(CALCULATE([Respondents], KEEPFILTERS('Charging'[Home_Charging_Possible] = "Yes")), [Respondents])
		formatString: 0.00%
		displayFolder: Charging and incentives
		lineageTag: 63cf03e7-c904-4943-ac7e-3a9913437fd5

	/// Share with subsidy available within current filters.
	measure 'Subsidy Availability Rate' = DIVIDE(CALCULATE([Respondents], KEEPFILTERS('Attitude and Incentive'[Subsidy_Available] = "Yes")), [Respondents])
		formatString: 0.00%
		displayFolder: Charging and incentives
		lineageTag: 617a4f89-f77d-438f-aaac-2c045040537f

	/// Average number of charging stations near home.
	measure 'Average Chargers Near Home' = AVERAGE('EV Respondents'[Charging_Stations_Near_Home])
		formatString: 0.00
		displayFolder: Charging and incentives
		lineageTag: a12905e1-ff55-47cc-88f1-cdd3817dfbde

	/// Average number of charging stations near work.
	measure 'Average Chargers Near Work' = AVERAGE('EV Respondents'[Charging_Stations_Near_Work])
		formatString: 0.00
		displayFolder: Charging and incentives
		lineageTag: 9f25f38b-b36c-4a45-b31c-afe22c9057b6

