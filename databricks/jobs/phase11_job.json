{
  "name": "EV Analytics Phase 11 Databricks",
  "max_concurrent_runs": 1,
  "job_clusters": [
    {
      "job_cluster_key": "phase11_spark",
      "new_cluster": {
        "spark_version": "16.4.x-scala2.12",
        "node_type_id": "m5d.large",
        "num_workers": 1,
        "autotermination_minutes": 20,
        "spark_conf": {
          "spark.sql.session.timeZone": "UTC"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "phase11_e2e",
      "job_cluster_key": "phase11_spark",
      "notebook_task": {
        "notebook_path": "/Shared/ev_phase11/phase11_runner",
        "source": "WORKSPACE"
      },
      "timeout_seconds": 7200,
      "max_retries": 0
    }
  ]
}
